# Copy to .env:  cp .env.example .env
# Demo values only. Nothing here is a real secret; production secrets come from a secret store.

POSTGRES_USER=carelink
POSTGRES_PASSWORD=carelink_dev_only
POSTGRES_DB=carelink
# Host port for psql / DB tools (5433 avoids clashing with a Postgres already on 5432).
DB_HOST_PORT=5433

# Leave unset to use the bundled postgres container. To use a Postgres already on your machine:
#   DATABASE_URL=postgresql://USER:PASS@host.docker.internal:5432/carelink
#   TEST_DATABASE_URL=postgresql://USER:PASS@host.docker.internal:5432/carelink_test
# then run `make up-nodb`.
# DATABASE_URL=
# TEST_DATABASE_URL=

# "Today" for the follow-up rule. Fixed to the pack's date so the sample response reproduces.
# Leave blank to use the real date in Africa/Lusaka.
AS_OF_DATE=2026-10-06

# Static demo tokens 
AUTH_TOKENS=clin-0101-demo-token=CLINICIAN:FAC-0101:clinician.fac0101;clin-0207-demo-token=CLINICIAN:FAC-0207:clinician.fac0207;district-demo-token=DISTRICT_OFFICER:*:district.officer

LOG_LEVEL=INFO
